using Toybox.Lang;
using Toybox.Time;
using Toybox.Time.Gregorian;

(:test)
module MyTests {

  function verifyTimeUTC(_oLogger, _iEpochTimestamp, _iReference_year, _iReference_month, _iReference_day, _iReference_hour, _iReference_min, _iReference_sec) {
    // Components
    var oTime = new Time.Moment(_iEpochTimestamp);
    var oTimeInfo = Gregorian.utcInfo(oTime, Time.FORMAT_SHORT);
    var iVerify_year = oTimeInfo.year;
    var iVerify_month = oTimeInfo.month;
    var iVerify_day = oTimeInfo.day;
    var iVerify_hour = oTimeInfo.hour;
    var iVerify_min = oTimeInfo.min;
    var iVerify_sec = oTimeInfo.sec;
    // ... round minutes
    if(_iReference_sec == null) {
      if(iVerify_sec >= 30) {
        iVerify_min += 1;
        if(iVerify_min >= 60) {
          iVerify_min -= 60;
          iVerify_hour += 1;
          if(iVerify_hour >= 24) {
            iVerify_hour -= 24;
          }
        }
      }
    }

    // Verify date
    if(iVerify_year != _iReference_year) {
      _oLogger.error(Lang.format("Date (year) mismatch! Got: $1$; Expected: *$2$*, $3$, $4$, $5$:$6$:$7$", [iVerify_year, _iReference_year, _iReference_month, _iReference_day, _iReference_hour, _iReference_min, _iReference_sec]));
      return -1;
    }
    if(iVerify_month != _iReference_month) {
      _oLogger.error(Lang.format("Date (month) mismatch! Got: $1$; Expected: $2$, *$3$*, $4$, $5$:$6$:$7$", [iVerify_month, _iReference_year, _iReference_month, _iReference_day, _iReference_hour, _iReference_min, _iReference_sec]));
      return -1;
    }
    if(iVerify_day != _iReference_day) {
      _oLogger.error(Lang.format("Date (day) mismatch! Got: $1$; Expected: $2$, $3$, *$4$*, $5$:$6$:$7$", [iVerify_day, _iReference_year, _iReference_month, _iReference_day, _iReference_hour, _iReference_min, _iReference_sec]));
      return -1;
    }

    // Verify time
    var iDelta_reference = 3600*_iReference_hour + 60*_iReference_min;
    var iDelta_verify = 3600*iVerify_hour + 60*iVerify_min;
    if(_iReference_sec != null) {
      iDelta_reference += _iReference_sec;
      iDelta_verify += iVerify_sec;
    }
    var iDelta = (iDelta_verify - iDelta_reference).abs();
    //_oLogger.error(Lang.format("Time match (delta=$1$)! Got: $2$:$3$:$4$; Expected: $5$, $6$, $7$, *$8$:$9$:$10$*", [iDelta, iVerify_hour, iVerify_min, iVerify_sec, _iReference_year, _iReference_month, _iReference_day, _iReference_hour, _iReference_min, _iReference_sec]));
    for(var i=0; i<=5; i++) {
      if(iDelta < 60*(i+1)) {
        return i;
      }
    }
    _oLogger.error(Lang.format("Time mismatch (delta=$1$)! Got: $2$:$3$:$4$; Expected: $5$, $6$, $7$, *$8$:$9$:$10$*", [iDelta, iVerify_hour, iVerify_min, iVerify_sec, _iReference_year, _iReference_month, _iReference_day, _iReference_hour, _iReference_min, _iReference_sec]));
    return -1;
  }

  function unitTest_CH_PyEphem(_oLogger, _aaiAlmanac) {
    // Table: year, month, sunrise, transit, sunset (UTC)
    // (see ../devel/almanac script)

    // Sun Almanac computation object
    var oAlmanac = new MyAlmanac();
    oAlmanac.setLocation("CH/Bern", 46.9524055555556d, 7.43958333333333d, 0.0f);

    // Loop through reference data
    var aiError = [0, 0, 0, 0, 0, 0, 0];  // Time difference: error, 0, 1, 2, 3, 4, 5 minutes
    for(var i=0; i<_aaiAlmanac.size(); i++) {
      var iReference_year = _aaiAlmanac[i][0];
      var iReference_month = _aaiAlmanac[i][1];
      var iReference_day = _aaiAlmanac[i][2];
      var iReference_sunrise = _aaiAlmanac[i][3];
      var iReference_transit = _aaiAlmanac[i][4];
      var iReference_sunset = _aaiAlmanac[i][5];

      // Compute almanac data
      var iEpochDate = Gregorian.moment({:year => iReference_year, :month => iReference_month, :day => iReference_day}).value();
      oAlmanac.compute(iEpochDate, null, true);

      // Unit tests
      var iDelta;
      var iReference_hour;
      var iReference_min;
      var iReference_sec;
      // ... sunrise
      iReference_sec = iReference_sunrise % 100;
      iReference_min = (iReference_sunrise - iReference_sec)/100 % 100;
      iReference_hour = (iReference_sunrise - 100*iReference_min - iReference_sec)/10000;
      iDelta = MyTests.verifyTimeUTC(_oLogger, oAlmanac.iEpochSunrise, iReference_year, iReference_month, iReference_day, iReference_hour, iReference_min, iReference_sec);
      aiError[iDelta+1] += 1;
      // ... transit
      iReference_sec = iReference_transit % 100;
      iReference_min = (iReference_transit - iReference_sec)/100 % 100;
      iReference_hour = (iReference_transit - 100*iReference_min - iReference_sec)/10000;
      iDelta = MyTests.verifyTimeUTC(_oLogger, oAlmanac.iEpochTransit, iReference_year, iReference_month, iReference_day, iReference_hour, iReference_min, iReference_sec);
      aiError[iDelta+1] += 1;
      // ... sunset
      iReference_sec = iReference_sunset % 100;
      iReference_min = (iReference_sunset - iReference_sec)/100 % 100;
      iReference_hour = (iReference_sunset - 100*iReference_min - iReference_sec)/10000;
      iDelta = MyTests.verifyTimeUTC(_oLogger, oAlmanac.iEpochSunset, iReference_year, iReference_month, iReference_day, iReference_hour, iReference_min, iReference_sec);
      aiError[iDelta+1] += 1;
    }

    // Statistics
    _oLogger.debug("STATISTICS");
    for(var i=0; i<=5; i++) {
      _oLogger.debug(Lang.format("Delta=$1$: $2$", [i, aiError[i+1]]));
    }
    if(aiError[0] > 0) {
      _oLogger.error(Lang.format("Delta>5: $1$", [aiError[0]]));
      return false;
    }
    return true;
  }

  function unitTest_CH_VFRGuide(_oLogger, _aaiAlmanac) {
    // Table: year, month, dawn, sunrise, sunset, dusk (UTC)

    // Sun Almanac computation object
    var oAlmanac = new MyAlmanac();
    oAlmanac.setLocation("CH/Bern", 46.9524055555556d, 7.43958333333333d, 0.0f);

    // Loop through reference data
    var aiError = [0, 0, 0, 0, 0, 0, 0];  // Time difference: error, 0, 1, 2, 3, 4, 5 minutes
    for(var i=0; i<_aaiAlmanac.size(); i++) {
      var iReference_year = _aaiAlmanac[i][0];
      var iReference_month = _aaiAlmanac[i][1];
      var iReference_day = _aaiAlmanac[i][2];
      var iReference_dawn = _aaiAlmanac[i][3];
      var iReference_sunrise = _aaiAlmanac[i][4];
      var iReference_sunset = _aaiAlmanac[i][5];
      var iReference_dusk = _aaiAlmanac[i][6];

      // Compute almanac data
      var iEpochDate = Gregorian.moment({:year => iReference_year, :month => iReference_month, :day => iReference_day}).value();
      oAlmanac.compute(iEpochDate, null, true);

      // Unit tests
      var iDelta;
      var iReference_hour;
      var iReference_min;
      // ... civil dawn
      iReference_min = iReference_dawn % 100;
      iReference_hour = (iReference_dawn - iReference_min)/100;
      iDelta = MyTests.verifyTimeUTC(_oLogger, oAlmanac.iEpochCivilDawn, iReference_year, iReference_month, iReference_day, iReference_hour, iReference_min, null);
      aiError[iDelta+1] += 1;
      // ... sunrise
      iReference_min = iReference_sunrise % 100;
      iReference_hour = (iReference_sunrise - iReference_min)/100;
      iDelta = MyTests.verifyTimeUTC(_oLogger, oAlmanac.iEpochSunrise, iReference_year, iReference_month, iReference_day, iReference_hour, iReference_min, null);
      aiError[iDelta+1] += 1;
      // ... sunset
      iReference_min = iReference_sunset % 100;
      iReference_hour = (iReference_sunset - iReference_min)/100;
      iDelta = MyTests.verifyTimeUTC(_oLogger, oAlmanac.iEpochSunset, iReference_year, iReference_month, iReference_day, iReference_hour, iReference_min, null);
      aiError[iDelta+1] += 1;
      // ... civil dusk
      iReference_min = iReference_dusk % 100;
      iReference_hour = (iReference_dusk - iReference_min)/100;
      iDelta = MyTests.verifyTimeUTC(_oLogger, oAlmanac.iEpochCivilDusk, iReference_year, iReference_month, iReference_day, iReference_hour, iReference_min, null);
      aiError[iDelta+1] += 1;
    }

    // Statistics
    _oLogger.debug("STATISTICS");
    for(var i=0; i<=5; i++) {
      _oLogger.debug(Lang.format("Delta=$1$: $2$", [i, aiError[i+1]]));
    }
    if(aiError[0] > 0) {
      _oLogger.error(Lang.format("Delta>5: $1$", [aiError[0]]));
      return false;
    }
    return true;
  }

